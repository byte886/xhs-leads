# --- 安全红线：登录态与敏感数据绝不入库 ---
data/
data/*.db
data/*.sqlite3
data/images/

# --- Python 产物 ---
__pycache__/
*.pyc
.pytest_cache/
.coverage
*.egg-info/

# --- 本地环境 ---
.DS_Store

# --- 本地环境（新机器部署） ---
backend/.venv/
backend/target/
backend/src/data/

# --- 前端工程 ---
frontend/node_modules/
frontend/dist/

# --- PyInstaller 打包产物（B 批壳，不入库；产物为本地交付物） ---
build/
dist/
*.spec.bak

# --- 原型自检产物（非交付物） ---
docs/prototype/_shots/
*.tsbuildinfo
target/
# R-6.84：内置扩展的壳（manifest/background）随仓分发——采集窗标签分组靠它，
# 否则 builtin_extension_dir() 永远返回 None、分组静默失效。
# content.js 不入库（页面级内容脚本，历史预留位，当前无实现）。
extension/content.js

# --- 登录态敏感：cookie 落盘文件绝不入库 ---
data/cookies*.json
data/cookies*.bak
data/cookies*
/.venv

# --- 本地敏感配置与 Chrome 调试 Profile（绝不入库） ---
data/cdp_config.json
data/llm_config.json
data/persona.json
data/chrome-profile/
data/profile/   # 引擎无头持久化 profile（dev 态 data/profile、打包态 App 内 data/profile）——登录态/全部运行时状态
data/accounts.json
data/license*.pem
data/risk_state.json

# --- 质检工具产物（不入库；gauntlet 质量门 crap/dry/mutate 输出） ---
.metrics/
coverage.lcov
target/
coverage/

# --- 运行时状态与日志（不入库） ---
data/risk_state.json
data/logs/
data/license_private.pem

